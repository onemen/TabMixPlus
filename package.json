{
  "name": "tab-mix-plus",
  "version": "1.0.0",
  "description": "New Tab Mix Plus for modern Firefox",
  "type": "module",
  "scripts": {
    "lint": "eslint --format stylish --fix --cache --cache-strategy content --cache-location config/.eslintcache",
    "lint:test": "eslint --format stylish --cache --cache-strategy content --cache-location config/.eslintcache",
    "lint:clean": "eslint --format stylish",
    "format": "prettier --config config/prettier.config.js --ignore-path config/.prettierignore --write .",
    "prepare": "husky config/husky",
    "stylelint": "stylelint --fix --config config/.stylelintrc.json \"addon/**/*.css\"",
    "tsc:clean": "node config/typecheck.js tsc7",
    "typecheck": "node node_modules/typescript7/bin/tsc --build > tsc.local.txt"
  },
  "prettier": "./config/prettier.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onemen/TabMixPlus.git"
  },
  "keywords": [],
  "author": "tabmix.onemen@gmail.com",
  "license": "MPL",
  "bugs": {
    "url": "https://github.com/onemen/TabMixPlus/issues"
  },
  "homepage": "https://github.com/onemen/TabMixPlus#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/eslint-plugin-sdl": "1.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-mozilla": "^5.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tabmix": "workspace:./config/eslint-plugin-tabmix",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "typescript7": "npm:typescript@^7.0.2"
  }
}
